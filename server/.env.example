# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA faca commit do .env com credenciais reais (ele esta no .gitignore).

# ---- Conexao com o PostgreSQL ----
# RECOMENDADO: use a "URL de Conexao Interna" fornecida pela plataforma.
# Esta linha tem prioridade sobre as variaveis PG* abaixo.
# Exemplo (coloque a senha real somente nas variaveis da plataforma):
# DATABASE_URL=postgres://postgres:SENHA@games_dejad-desafio:5432/dejad_desafio?sslmode=disable
DATABASE_URL=

# Alternativa: variaveis separadas (usadas se DATABASE_URL estiver vazia)
PGHOST=games_dejad-desafio
PGPORT=5432
PGUSER=postgres
PGDATABASE=dejad_desafio
PGPASSWORD=coloque-a-senha-aqui

# SSL do banco. Como a URL interna usa sslmode=disable, mantenha false.
# (use true apenas em bancos gerenciados que exigem SSL)
PGSSL=false

# ---- Autenticacao do painel (host) ----
# O painel acessa via painel.html#chave=ESTA_CHAVE
HOST_KEY=troque-esta-chave-secreta

# ---- HTTP ----
PORT=5000

# Origens permitidas no CORS, separadas por virgula.
# Coloque a URL exata do seu GitHub Pages, ex.:
# CORS_ORIGIN=https://SEU-USUARIO.github.io
# Use * apenas para teste local.
CORS_ORIGIN=*

# ---- Regras do jogo ----
MATCH_MINUTES=20
START_COUNTDOWN_SECONDS=5
